# Copy this file to .env and fill in ONE provider block. Never commit .env.
# Free-tier limits below were checked on 2026-10-06 and can change; see each provider's docs.

# Groq free plan (no card needed): https://console.groq.com/keys
# Limits: 30 requests/min, 1,000 requests/day, 8,000 tokens/min, 200,000 tokens/day
# Use with: --model openai:openai/gpt-oss-120b   or   --model openai:openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MAX_RPM=2

# OpenRouter free models: https://openrouter.ai/keys
# Limits: 20 requests/min; 50 requests/day (1,000/day after a one-time 10 USD credit purchase)
# Use with: --model openai:google/gemma-4-31b-it:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MAX_RPM=15

# Google AI Studio free tier (Gemma). Prompts on the free tier may be used to improve Google products.
# Check the exact model name in AI Studio before running.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=

# Local Ollama server (free, slow without a GPU): ollama pull qwen2.5:7b
# Use with: --model openai:qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# Optional and paid: Amazon Bedrock (use with --model bedrock:<model id>)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
